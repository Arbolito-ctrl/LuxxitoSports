# ============================================================================
# CONFIGURACIÓN DE ENTORNO - LUXXITO SPORTS API (TALLER 3 - SI806)
# ============================================================================

# Puerto del servidor Express
PORT=3000
NODE_ENV=development
API_BASE_URL=https://luxxito-sports-api.onrender.com/api

# ----------------------------------------------------------------------------
# OPCIÓN 1 (Recomendada): Conexión directa / Pooler a PostgreSQL de Supabase
# Obtén esta URL en Supabase Dashboard -> Connect -> Transaction/Session Pooler
# Ejemplo: postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.tu_proyecto:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ----------------------------------------------------------------------------
# OPCIÓN 2 (Opcional): Credenciales de API de Supabase (@supabase/supabase-js)
# Obtén estos valores en Supabase Dashboard -> Project Settings -> API
# ----------------------------------------------------------------------------
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Secreto para firma de tokens JWT y tickets QR verificables
JWT_SECRET=luxxito_sports_uni_si806_secret_key_2026

# Sugerencia de nombre por DNI en el registro (https://decolecta.com, plan gratuito: 1000 consultas/mes).
# Solo en el servidor (Render y este .env): NUNCA en la app. Si falta, el registro funciona sin sugerencia.
DECOLECTA_TOKEN=tu_token_de_decolecta_aqui
