{
  "info": {
    "name": "Luxxito Sports API REST - Taller 3 (SI806 UNI)",
    "_postman_id": "a7f90211-88b4-41c9-99e0-112233445566",
    "description": "Colección completa de endpoints para Luxxito Sports (Complejos, Canchas, Disponibilidad, Cotización, Reservas, Pagos y Cancelación 24h).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Diagnóstico",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "2. Listar Complejos Deportivos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/complejos",
          "host": ["{{baseUrl}}"],
          "path": ["complejos"]
        }
      }
    },
    {
      "name": "3. Listar y Filtrar Canchas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/canchas?deporte=Futbol 7",
          "host": ["{{baseUrl}}"],
          "path": ["canchas"],
          "query": [{ "key": "deporte", "value": "Futbol 7" }]
        }
      }
    },
    {
      "name": "4. Crear Nueva Cancha (CRUD Create)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"complejo_id\": 1,\n  \"nombre\": \"Cancha Sintética VIP\",\n  \"deporte\": \"Futbol 5\",\n  \"superficie\": \"Grass Sintético FIFA Pro\",\n  \"techada\": true,\n  \"iluminacion\": true,\n  \"precio_hora_diurno\": 80,\n  \"precio_hora_nocturno\": 105\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/canchas",
          "host": ["{{baseUrl}}"],
          "path": ["canchas"]
        }
      }
    },
    {
      "name": "5. Consultar Disponibilidad y Extras por Fecha (Lógica de Negocio)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/canchas/1/disponibilidad?fecha=2026-11-15&hora=18",
          "host": ["{{baseUrl}}"],
          "path": ["canchas", "1", "disponibilidad"],
          "query": [
            { "key": "fecha", "value": "2026-11-15" },
            { "key": "hora", "value": "18" }
          ]
        }
      }
    },
    {
