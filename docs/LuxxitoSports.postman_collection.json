        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cancha_id\": 1,\n  \"fecha\": \"2026-11-15\",\n  \"hora_inicio\": 17,\n  \"hora_fin\": 19,\n  \"extras\": [\n    { \"extra_id\": 1, \"cantidad\": 2 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservas/cotizar",
          "host": ["{{baseUrl}}"],
          "path": ["reservas", "cotizar"]
        }
      }
    },
    {
      "name": "7. Crear Reserva con Bloqueo de 20 min (CRUD Create + Reglas)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cancha_id\": 1,\n  \"cliente_nombre\": \"Carlos Mendoza\",\n  \"cliente_dni\": \"74125896\",\n  \"cliente_telefono\": \"999888777\",\n  \"cliente_email\": \"carlos.mendoza@uni.pe\",\n  \"fecha\": \"2026-11-15\",\n  \"hora_inicio\": 19,\n  \"hora_fin\": 21,\n  \"notas\": \"Partido FIIS UNI\",\n  \"extras\": [\n    { \"extra_id\": 1, \"cantidad\": 1 },\n    { \"extra_id\": 2, \"cantidad\": 1 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservas",
          "host": ["{{baseUrl}}"],
          "path": ["reservas"]
        }
      }
    },
    {
